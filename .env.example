# ─────────────────────────────────────────────────────────────
# PLATEA 2.0 — Variables de entorno (plantilla)
# Copiar a .env y completar. NUNCA subir .env al repositorio.
# La API valida estas variables al arrancar y no inicia si faltan (Doc 11 §5).
# ─────────────────────────────────────────────────────────────

# Entorno
NODE_ENV=development

# API
API_PORT=3010
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3011

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://platea:platea@localhost:5433/platea?schema=public

# Redis (cache, colas, adaptador WebSocket)
REDIS_URL=redis://localhost:6380

# JWT — usar cadenas largas y aleatorias distintas por entorno
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-caracteres-minimo
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo-y-aleatorio-distinto-al-anterior
JWT_REFRESH_TTL=7d

# Firma de integridad de facturas (hash) — secreto de servidor (00E)
INVOICE_HASH_SECRET=cambia-esto-por-un-secreto-exclusivo-para-el-hash-de-facturas

# TOTP / MFA
MFA_ISSUER=PLATEA 2.0

# Comisión SaaS por sesión de mesa cerrada y pagada (DD1)
COMMISSION_AMOUNT_USD=0.30

# Web (Next.js)
WEB_PORT=3011
NEXT_PUBLIC_API_URL=http://localhost:3010/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3010
