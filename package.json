{
  "name": "platea-2.0",
  "version": "0.1.0",
  "private": true,
  "description": "PLATEA 2.0 — Plataforma SaaS para Food Truck Parks (monorepo)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @platea/api start:dev",
    "dev:web": "pnpm --filter @platea/web dev",
    "db:migrate": "pnpm --filter @platea/api prisma:migrate",
    "db:seed": "pnpm --filter @platea/api prisma:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  }
}
